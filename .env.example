# Explicit shell environment only; this file is not loaded automatically.
MODELPORT_DATA_DIR=.modelport
# Generate a strong operator credential or let ModelPort create operator-token.
# MODELPORT_TOKEN=
MODELPORT_ALLOWED_HOSTS=localhost,127.0.0.1
MODELPORT_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,http://127.0.0.1:5173,http://localhost:5173
# MODELPORT_WEB_DIR=/absolute/path/to/web/dist
